# Lechfolio Git ignore rules.
#
# Keep local editor, operating system, and dependency artifacts out of the
# theme repository while preserving source, assets, and WordPress templates.

# Operating system files.
.DS_Store
Thumbs.db
Desktop.ini

# Editor and IDE folders.
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Logs and temporary files.
*.log
*.tmp
*.temp

# Dependency and build output folders.
node_modules/
vendor/
dist/
build/

# Local environment files.
.env
.env.*
